# ===== 应用 =====
APP_NAME=Word 文档智能审查系统
DEBUG=true

# ===== 数据库（开发用 SQLite，生产切 PostgreSQL，见 require.md 5.5）=====
DATABASE_URL=sqlite:///./data/app.db
# 生产示例（切换后仅改此行）：
# DATABASE_URL=postgresql+psycopg://docreview:password@localhost:5432/docreview

# ===== 文件目录 =====
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ===== CORS（前端开发地址）=====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== LLM 配置 =====
# 可选值: mock | deepseek | openai | tongyi | ollama
# mock：不调用任何外部模型，使用内置规则引擎演示完整流程（开发/演示默认）
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# DeepSeek（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 通义千问（DashScope）
DASHSCOPE_API_KEY=

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434
